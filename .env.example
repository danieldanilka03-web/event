# Строка подключения к PostgreSQL. Обязательный параметр.
#
# Supabase (рекомендуется для деплоя на Vercel) — бери СЕССИОННЫЙ пулер (порт 5432),
# не транзакционный 6543: на нём ломаются prepared statements и FOR UPDATE,
# а на них держится логика брони мест.
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Прямой URL (db.<ref>.supabase.co:5432) с февраля 2024 доступен только по IPv6 —
# Vercel до него не достучится, а локально будет работать в обоих режимах.
#
# Neon (альтернатива) — pooled строка, драйвер выбирается автоматически:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Секрет для подписи JWT (минимум 32 случайных символа). Обязательный параметр.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Публичный адрес приложения — используется в QR-коде билета.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
